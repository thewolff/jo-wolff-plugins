{
  "name": "brb",
  "description": "Hold needs-you asks in a digest while you are away; on-fire items still come through.",
  "version": "0.3.0",
  "author": { "name": "Jo Wolff" },
  "license": "MIT",
  "repository": "https://github.com/thewolff/jo-wolff-plugins",
  "keywords": ["agents", "hooks"],
  "state": [
    { "path": "$XDG_STATE_HOME/brb", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/prune.mjs\" --days 30" },
    { "path": "$XDG_CONFIG_HOME/brb/config.json", "kind": "file", "retentionDays": null, "prune": null }
  ]
}
