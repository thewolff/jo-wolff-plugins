{
  "$comment": "The block fires once per size: the same input (a transcript grown from 125,000 to 180,000 tokens of recorded usage, no calibration) a second time in the same compaction window passes, because the next block is due only 150,000 tokens later, so the person can always end the session. The once-mark proves the first stop was blocked.",
  "event": "Stop",
  "expect": "silent",
  "sibling": "stop-blocks-near-full.scenario.json",
  "transcript": [{ "type": "user", "message": { "role": "user", "content": "carry on with the port" } }, { "type": "assistant", "isSidechain": false, "message": { "role": "assistant", "content": [{ "type": "text", "text": "Started." }], "usage": { "input_tokens": 2, "cache_creation_input_tokens": 9998, "cache_read_input_tokens": 115000, "output_tokens": 5 } } }, { "type": "user", "message": { "role": "user", "content": "keep going" } }, { "type": "assistant", "isSidechain": false, "message": { "role": "assistant", "content": [{ "type": "text", "text": "Done." }], "usage": { "input_tokens": 2, "cache_creation_input_tokens": 9998, "cache_read_input_tokens": 170000, "output_tokens": 5 } } }],
  "before": [{ "stdin": { "hook_event_name": "Stop", "session_id": "${SESSION_ID}", "cwd": "${CWD}", "transcript_path": "${TRANSCRIPT}", "stop_hook_active": false, "last_assistant_message": "Done." } }],
  "stdin": { "hook_event_name": "Stop", "session_id": "${SESSION_ID}", "cwd": "${CWD}", "transcript_path": "${TRANSCRIPT}", "stop_hook_active": false, "last_assistant_message": "Done." },
  "after": { "commands": ["grep -q stopBlocked \"${XDG_STATE_HOME}/continuity/sessions/${SESSION_ID}.json\""] }
}
