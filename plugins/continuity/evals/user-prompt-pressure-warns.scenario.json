{
  "$comment": "No calibration file and a transcript whose first assistant reply recorded 125,000 tokens of usage and whose last recorded 2 input + 170,000 cache read + 9,998 cache creation = 180,000: past the 175,000 default ask point and more than the 40,000 default margin past where the session started, so the prompt carries the handoff request once.",
  "event": "UserPromptSubmit",
  "expect": "systemMessage",
  "reason": "/continuity:handoff",
  "transcript": [{ "type": "user", "message": { "role": "user", "content": "carry on with the port" } }, { "type": "assistant", "isSidechain": false, "message": { "role": "assistant", "content": [{ "type": "text", "text": "Started." }], "usage": { "input_tokens": 2, "cache_creation_input_tokens": 9998, "cache_read_input_tokens": 115000, "output_tokens": 5 } } }, { "type": "user", "message": { "role": "user", "content": "keep going" } }, { "type": "assistant", "isSidechain": false, "message": { "role": "assistant", "content": [{ "type": "text", "text": "Done." }], "usage": { "input_tokens": 2, "cache_creation_input_tokens": 9998, "cache_read_input_tokens": 170000, "output_tokens": 5 } } }],
  "before": [{ "event": "SessionStart", "stdin": { "hook_event_name": "SessionStart", "session_id": "${SESSION_ID}", "cwd": "${CWD}", "source": "startup" } }],
  "stdin": { "hook_event_name": "UserPromptSubmit", "session_id": "${SESSION_ID}", "cwd": "${CWD}", "transcript_path": "${TRANSCRIPT}", "prompt": "carry on" },
  "after": { "commands": ["grep -q promptWarned \"${XDG_STATE_HOME}/continuity/sessions/${SESSION_ID}.json\""] }
}
