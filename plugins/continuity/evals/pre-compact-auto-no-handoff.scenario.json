{
  "$comment": "Auto-compaction with no handoff written, on Claude Code's documented PreCompact payload (trigger and custom_instructions, no token_count): the snapshot is saved, the heartbeat lands, no calibration record is made, and the person is told (systemMessage) that the judgment layer was not captured.",
  "event": "PreCompact",
  "expect": "systemMessage",
  "reason": "no handoff written",
  "setup": { "commands": ["git -C \"${CWD}\" checkout -q -b feature/port", "echo draft > \"${CWD}/notes.md\""] },
  "transcript": [
    { "type": "user", "message": { "role": "user", "content": "port the continuity hooks" } },
    { "type": "assistant", "message": { "role": "assistant", "content": [{ "type": "tool_use", "name": "Write", "input": { "file_path": "${CWD}/notes.md", "content": "draft" } }] } },
    { "type": "user", "message": { "role": "user", "content": [{ "type": "text", "text": "now the tests" }] } }
  ],
  "stdin": { "hook_event_name": "PreCompact", "session_id": "${SESSION_ID}", "cwd": "${CWD}", "transcript_path": "${TRANSCRIPT}", "trigger": "auto", "custom_instructions": "" },
  "after": {
    "exists": ["$XDG_STATE_HOME/continuity/${SESSION_ID}.json", "$XDG_STATE_HOME/continuity/heartbeat.ndjson"],
    "absent": ["$XDG_STATE_HOME/continuity/calibration.ndjson"],
    "commands": [
      "grep -q '\"branch\": \"feature/port\"' \"${XDG_STATE_HOME}/continuity/${SESSION_ID}.json\"",
      "grep -q 'notes.md' \"${XDG_STATE_HOME}/continuity/${SESSION_ID}.json\"",
      "grep -q 'now the tests' \"${XDG_STATE_HOME}/continuity/${SESSION_ID}.json\"",
      "grep -q '\"present\": false' \"${XDG_STATE_HOME}/continuity/${SESSION_ID}.json\"",
      "grep -c '\"outcome\":\"started\"' \"${XDG_STATE_HOME}/continuity/heartbeat.ndjson\" | grep -qx 1",
      "grep -c '\"outcome\":\"ok\"' \"${XDG_STATE_HOME}/continuity/heartbeat.ndjson\" | grep -qx 1"
    ]
  }
}
