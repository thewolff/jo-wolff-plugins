{
  "$comment": "Pairing on: SessionEnd prints nothing, writes the carry marker for the worktree and the final snapshot.",
  "event": "SessionEnd",
  "expect": "silent",
  "setup": {
    "commands": [
      "node \"${PLUGIN_DIR}/evals/pair-start.mjs\" \"${SESSION_ID}\""
    ]
  },
  "stdin": {
    "session_id": "${SESSION_ID}",
    "transcript_path": "${TRANSCRIPT}",
    "cwd": "${CWD}",
    "hook_event_name": "SessionEnd",
    "reason": "clear"
  },
  "after": {
    "commands": [
      "ls ~/.local/state/paired-coding/carry/*.json >/dev/null"
    ]
  }
}
