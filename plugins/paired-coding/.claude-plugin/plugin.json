{
  "name": "paired-coding",
  "description": "Pair with an agent one change set at a time: it proposes a card naming the decision inside the change, you agree in conversation, and only then does it write.",
  "version": "1.5.0",
  "author": { "name": "Jo Wolff" },
  "license": "MIT",
  "repository": "https://github.com/thewolff/jo-wolff-plugins",
  "keywords": ["agents", "pairing", "pair-programming", "code-review", "gate"],
  "state": [
    {"path": "~/.local/state/paired-coding", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/prune.mjs\" --days 30"},
    {"path": "$TMPDIR/paired-coding-*", "retentionDays": 0, "prune": null}
  ]
}
