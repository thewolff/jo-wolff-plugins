{
  "name": "pattern-check",
  "description": "Before big work in a repository, make the agent find the existing pattern for each new piece and record reuse, replace or new; hooks hold writes, commits and PRs until that receipt exists.",
  "version": "0.4.1",
  "author": { "name": "Jo Wolff" },
  "license": "MIT",
  "repository": "https://github.com/thewolff/jo-wolff-plugins",
  "keywords": ["agents", "patterns", "reuse", "hooks", "code-review", "yagni"],
  "state": [
    {"path": "$XDG_STATE_HOME/pattern-check", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pattern-check.mjs\" prune --days 30"},
    {"path": "$XDG_CONFIG_HOME/pattern-check/config.json", "kind": "file", "retentionDays": null, "prune": null},
    {"path": "<worktree>/.pattern-check", "retentionDays": null, "prune": null}
  ]
}
