{
  "name": "i-have-audhd",
  "displayName": "I have AuDHD",
  "description": "How to write to someone who is ADHD and autistic: the rules, the research behind each one, and a Stop hook that warns when a message buries what the reader needs.",
  "version": "1.7.1",
  "author": { "name": "Jo Wolff" },
  "license": "MIT",
  "repository": "https://github.com/thewolff/jo-wolff-plugins",
  "keywords": ["agents", "reporting", "communication", "handoff", "adhd", "autism", "audhd"],
  "state": [
    {"path": "~/.claude/.i-have-audhd-state", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/prune.mjs\" --days 30"},
    {"path": "~/.claude/i-have-audhd.json", "kind": "file", "retentionDays": null, "prune": null},
    {"path": "~/.claude/.i-have-audhd-off", "kind": "file", "retentionDays": null, "prune": null}
  ]
}
