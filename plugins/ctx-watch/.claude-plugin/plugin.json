{
  "name": "ctx-watch",
  "description": "Notices when the ctx daemon is dead, unsupervised, or stale, or its semantic index is not ready; self-heals where ctx allows; tells you at SessionStart and with a macOS popup from a launchd timer; and, on Stop, when a resumed session never consulted ctx history.",
  "version": "0.2.2",
  "author": { "name": "Jo Wolff" },
  "license": "MIT",
  "repository": "https://github.com/thewolff/jo-wolff-plugins",
  "keywords": ["agents", "hooks"],
  "state": [
    { "path": "$XDG_STATE_HOME/ctx-watch", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ctx-watch.mjs\" prune --days 30" },
    { "path": "$XDG_STATE_HOME/ctx-watch/checks.log", "kind": "file", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ctx-watch.mjs\" prune --days 30" },
    { "path": "$XDG_STATE_HOME/ctx-watch/resume", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ctx-watch.mjs\" prune --days 30" },
    { "path": "~/.claude/ctx-watch.json", "kind": "file", "retentionDays": null, "prune": null },
    { "path": "~/.claude/.ctx-watch-off", "kind": "file", "retentionDays": null, "prune": null }
  ]
}
