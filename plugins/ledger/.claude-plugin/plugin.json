{
  "name": "ledger",
  "description": "A durable record of the questions an agent asks you and the choices it makes without asking, in one SQLite file; hooks keep every question, answer and decision on a row and gate a push on it.",
  "version": "0.3.13",
  "author": { "name": "Jo Wolff" },
  "license": "MIT",
  "repository": "https://github.com/thewolff/jo-wolff-plugins",
  "keywords": ["agents", "ledger", "sqlite", "hooks", "approvals", "decisions"],
  "state": [
    {"path": "$XDG_STATE_HOME/ledger/canary", "retentionDays": 30, "prune": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger.mjs\" canary prune --days 30"},
    {"path": "$XDG_STATE_HOME/ledger/errors.log", "kind": "file", "retentionDays": null, "prune": null},
    {"path": "$XDG_DATA_HOME/ledger/ledger.db", "kind": "file", "retentionDays": null, "prune": null},
    {"path": "$XDG_CONFIG_HOME/ledger/config.json", "kind": "file", "retentionDays": null, "prune": null},
    {"path": "<worktree>/.ai/decision-log", "retentionDays": null, "prune": null},
    {"path": "$TMPDIR/ledger-*", "retentionDays": 0, "prune": null}
  ]
}
