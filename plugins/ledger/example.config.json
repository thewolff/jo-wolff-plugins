{
  "enabled": true,
  "db": "~/.local/share/ledger/ledger.db",
  "user": null,
  "timezone": null,
  "hooks": {
    "sessionStart": true,
    "preToolUse": true,
    "stop": true,
    "sessionEnd": true,
    "userPromptCommands": true
  },
  "forcing": {
    "denyAskWithoutRow": true,
    "stopAskRule": true,
    "pushNeedsNote": true,
    "stopDecisionRule": true,
    "decisionPhrases": [
      "I decided",
      "decided to",
      "assumption:",
      "assuming",
      "going with",
      "instead of",
      "chose",
      "I'll go with",
      "trade-off"
    ]
  },
  "inject": {
    "notes": 5,
    "elsewhere": true,
    "answers": true,
    "doctor": true
  }
}
