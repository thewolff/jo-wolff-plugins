{
  "enabled": true,
  "db": "~/.local/share/ledger/ledger.db",
  "user": null,
  "timezone": null,
  "hooks": {
    "sessionStart": true,
    "preToolUse": true,
    "stop": true,
    "sessionEnd": true,
    "userPromptCommands": true
  },
  "forcing": {
    "denyAskWithoutRow": true,
    "stopAskRule": true,
    "pushNeedsNote": true,
    "stopDecisionRule": true,
    "decisionPhrases": [
      "I decided",
      "decided to",
      "assumption:",
      "assuming",
      "going with",
      "chose",
      "I'll go with",
      "trade-off"
    ]
  },
  "inject": {
    "notes": 5,
    "elsewhere": true,
    "answers": true,
    "doctor": true
  },
  "sweep": {
    "autoWithdrawDays": 7
  },
  "digest": {
    "enabled": true,
    "issue": "thewolff/jo-issues#325"
  },
  "review": {
    "mode": "gate",
    "labs": [
      "codex"
    ],
    "models": null,
    "profiles": null,
    "maxRounds": 3,
    "judgeCommand": null
  }
}
