{
  "$comment": "Sibling of pre-tool-use-push-hyphen-cd-unreviewed-denied: the same literal hyphenated `cd`, once that HEAD is waived, goes through silently.",
  "event": "PreToolUse",
  "expect": "silent",
  "sibling": "pre-tool-use-push-hyphen-cd-unreviewed-denied.scenario.json",
  "setup": {
    "commands": [
      "git -c user.name=t -c user.email=t@t -C \"${CWD}\" commit -q --allow-empty -m init",
      "LEDGER_SESSION_ID=\"${SESSION_ID}\" node \"${PLUGIN_DIR}/scripts/ledger.mjs\" note \"pushing the change\"",
      "mkdir \"${CWD}/story-charts-step1\"",
      "git -C \"${CWD}/story-charts-step1\" init -q -b main",
      "echo one > \"${CWD}/story-charts-step1/a.txt\"",
      "git -C \"${CWD}/story-charts-step1\" add a.txt",
      "git -c user.name=t -c user.email=t@t -C \"${CWD}/story-charts-step1\" commit -q -m one",
      "cd \"${CWD}/story-charts-step1\" && LEDGER_SESSION_ID=\"${SESSION_ID}\" node \"${PLUGIN_DIR}/scripts/ledger.mjs\" review waive \"prototype, the human said push it\""
    ]
  },
  "stdin": {
    "session_id": "${SESSION_ID}",
    "transcript_path": "${TRANSCRIPT}",
    "cwd": "${CWD}",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "cd ${CWD}/story-charts-step1 && git push origin HEAD"
    }
  }
}
