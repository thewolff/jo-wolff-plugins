{
  "$comment": "`clock: false` in the config: no line.",
  "event": "UserPromptSubmit",
  "expect": "silent",
  "sibling": "clock-prompt-line.scenario.json",
  "setup": {
    "files": {
      "$XDG_CONFIG_HOME/coordinator/config.json": "{\"clock\": false}\n"
    }
  },
  "stdin": {
    "session_id": "${SESSION_ID}",
    "transcript_path": "${TRANSCRIPT}",
    "cwd": "${CWD}",
    "hook_event_name": "UserPromptSubmit",
    "permission_mode": "default",
    "prompt": "carry on",
    "prompt_id": "p-clock"
  }
}
